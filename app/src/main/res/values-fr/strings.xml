    <!-- OnboardingScreen -->
    <string name="onboarding_info_1">"NotiFilter exécute un service d’arrière-plan léger qui écoute toutes les notifications de l’appareil et les gère discrètement selon vos filtres.\n\nAucune donnée n’est envoyée hors de l’appareil ; NotiFilter n’a pas accès à Internet."</string>
    <string name="grant_permission">Accorder l’autorisation</string>
    <string name="onboarding_info_2">Sur certains appareils, l’optimisation de la batterie peut retarder le rejet des notifications et provoquer malgré tout une interruption initiale.\n\nCertains fabricants appliquent des optimisations encore plus agressives ; vous devrez peut-être activer « Exécuter au premier plan » dans les paramètres de l’application.</string>
    <string name="disable_optimization">Désactiver l’optimisation</string>

    <!-- AboutScreen -->
    <string name="about">À propos</string>
    <string name="app_description">" écoute toutes les notifications de l’appareil et gère discrètement celles qui correspondent à vos filtres."</string>
    <string name="app_links"><![CDATA[Sous licence <a href="https://github.com/BURG3R5/NotiFilter/blob/master/LICENSE">GPLv3</a><br/>Code source disponible sur <a href="https://github.com/BURG3R5/NotiFilter">GitHub</a><br/>Consultez le <a href="https://github.com/BURG3R5/NotiFilter/wiki">wiki du projet</a> pour en savoir plus]]></string>
    <string name="app_permissions"><![CDATA[Autorisations<small><ul><li>BIND_NOTIFICATION_LISTENER_SERVICE : écouter les notifications et y réagir</li><li>QUERY_ALL_PACKAGES : rechercher dans les applications installées lors de l’ajout de filtres</li><li>BIND_ACCESSIBILITY_SERVICE : exécuter les actions TAP_NOTIFICATION, le cas échéant</li><li>POST_NOTIFICATIONS : exécuter les actions ALERT, le cas échéant</li><li>ACCESS_NOTIFICATION_POLICY : exécuter les actions DISTURB, le cas échéant</li><li>REQUEST_IGNORE_BATTERY_OPTIMIZATIONS : exécuter les actions DISMISS_STALE, le cas échéant</li><li>FOREGROUND_SERVICE_SPECIAL_USE : placer facultativement le service principal au premier plan afin d’éviter les optimisations agressives d’Android</li></ul>D’autres autorisations peuvent être utilisées par des bibliothèques pour gérer certaines tâches, comme la mise à jour des widgets.</small>]]></string>
    <string name="dev_credit"><![CDATA[Développé par <a href="https://github.com/BURG3R5/">BURG3R5</a>]]></string>

